{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skrates:hive:mcp:conformance-manifest:v1",
  "title": "Hive MCP conformance provenance manifest",
  "type": "object",
  "$defs": {
    "gitObjectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vendoredArtifact": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "gitBlob": { "$ref": "#/$defs/gitObjectId" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "vendoredPath": {
          "type": "string",
          "pattern": "^schemas/upstream/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "required": ["path", "gitBlob", "sha256", "vendoredPath"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "stableCore": {
      "type": "object",
      "properties": {
        "status": { "const": "stable" },
        "protocolVersion": { "const": "2026-07-28" },
        "specification": { "const": "https://modelcontextprotocol.io/specification/2026-07-28" },
        "transport": { "const": "https://modelcontextprotocol.io/specification/2026-07-28/basic/transports/streamable-http" },
        "discovery": { "const": "https://modelcontextprotocol.io/specification/2026-07-28/server/discover" },
        "fixtures": {
          "type": "object",
          "properties": {
            "repository": { "const": "modelcontextprotocol/typescript-sdk" },
            "commit": { "$ref": "#/$defs/gitObjectId" },
            "tree": { "$ref": "#/$defs/gitObjectId" },
            "path": { "const": "packages/core-internal/test/corpus/fixtures/2026-07-28/manifest.json" },
            "gitBlob": { "$ref": "#/$defs/gitObjectId" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size": { "type": "integer", "minimum": 1 },
            "vendoredPath": { "const": "schemas/upstream/core-2026-07-28-fixture-manifest.json" },
            "corpus": {
              "type": "object",
              "properties": {
                "repository": { "const": "modelcontextprotocol/modelcontextprotocol" },
                "commit": { "$ref": "#/$defs/gitObjectId" },
                "tree": { "$ref": "#/$defs/gitObjectId" },
                "path": { "const": "schema/draft/examples" },
                "vendoredPath": { "const": "schemas/upstream/core-2026-07-28-fixtures" },
                "fileCount": { "const": 128 },
                "hashAlgorithm": { "const": "sha256-v1(relative-path NUL bytes NUL)" },
                "sha256": { "$ref": "#/$defs/sha256" }
              },
              "required": ["repository", "commit", "tree", "path", "vendoredPath", "fileCount", "hashAlgorithm", "sha256"],
              "additionalProperties": false
            }
          },
          "required": ["repository", "commit", "tree", "path", "gitBlob", "sha256", "size", "vendoredPath", "corpus"],
          "additionalProperties": false
        },
        "schemaTwin": {
          "type": "object",
          "properties": {
            "repository": { "const": "modelcontextprotocol/typescript-sdk" },
            "commit": { "$ref": "#/$defs/gitObjectId" },
            "path": { "const": "packages/core-internal/test/corpus/schema-twins/2026-07-28.schema.json" },
            "gitBlob": { "$ref": "#/$defs/gitObjectId" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size": { "type": "integer", "minimum": 1 },
            "vendoredPath": { "const": "schemas/upstream/core-2026-07-28.schema.json" },
            "manifest": { "$ref": "#/$defs/vendoredArtifact" }
          },
          "required": ["repository", "commit", "path", "gitBlob", "sha256", "size", "vendoredPath", "manifest"],
          "additionalProperties": false
        },
        "packages": {
          "type": "object",
          "properties": {
            "@modelcontextprotocol/client": { "const": "2.0.0" },
            "@modelcontextprotocol/server": { "const": "2.0.0" },
            "@modelcontextprotocol/node": { "const": "2.0.0" },
            "hono": { "const": "4.11.4" }
          },
          "required": ["@modelcontextprotocol/client", "@modelcontextprotocol/server", "@modelcontextprotocol/node", "hono"],
          "additionalProperties": false
        },
        "fixtureValidatorPackages": {
          "type": "object",
          "properties": {
            "ajv": { "const": "8.17.1" },
            "ajv-formats": { "const": "3.0.1" }
          },
          "required": ["ajv", "ajv-formats"],
          "additionalProperties": false
        }
      },
      "required": ["status", "protocolVersion", "specification", "transport", "discovery", "fixtures", "schemaTwin", "packages", "fixtureValidatorPackages"],
      "additionalProperties": false
    },
    "legacyQuarantine": {
      "type": "object",
      "properties": {
        "package": { "const": "@modelcontextprotocol/sdk" },
        "version": { "const": "1.29.0" },
        "allowedImport": { "const": "src/channel/claude.ts" },
        "removalOwner": { "const": "KRA-908" }
      },
      "required": ["package", "version", "allowedImport", "removalOwner"],
      "additionalProperties": false
    },
    "tasksExtension": {
      "type": "object",
      "properties": {
        "status": { "const": "experimental-unofficial" },
        "repository": { "const": "modelcontextprotocol/ext-tasks" },
        "commit": { "$ref": "#/$defs/gitObjectId" },
        "schema": { "$ref": "#/$defs/vendoredArtifact" },
        "specification": { "$ref": "#/$defs/vendoredArtifact" },
        "upstreamMissingCapabilityCode": { "const": -32003 },
        "hiveStableCoreMissingCapabilityCode": { "const": -32021 }
      },
      "required": ["status", "repository", "commit", "schema", "specification", "upstreamMissingCapabilityCode", "hiveStableCoreMissingCapabilityCode"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "stableCore", "legacyQuarantine", "tasksExtension"],
  "additionalProperties": false,
  "examples": [
