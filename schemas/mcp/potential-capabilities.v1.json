{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skrates:hive:mcp:potential-capabilities:v1",
  "title": "Hive MCP potential capability catalog",
  "type": "object",
  "$defs": {
    "cache": {
      "type": "object",
      "properties": {
        "cacheScope": { "enum": ["private", "public"] },
        "ttlMs": { "type": "integer", "minimum": 0 }
      },
      "required": ["cacheScope", "ttlMs"],
      "additionalProperties": false
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9:-]*$"
    },
    "issue": {
      "type": "string",
      "pattern": "^KRA-[1-9][0-9]*$"
    },
    "resource": {
      "type": "object",
      "properties": {
        "handleKind": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "server": { "enum": ["broker", "provider-ingress", "edge-control"] },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["resources/read", "subscriptions/listen"] }
        },
        "ownerIssue": { "$ref": "#/$defs/issue" },
        "callerRule": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "discoveryAnyScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scope" }
        },
        "cache": { "$ref": "#/$defs/cache" }
      },
      "required": ["handleKind", "server", "methods", "ownerIssue", "callerRule", "cache"],
      "additionalProperties": false
    },
    "referenceOnlyHandle": {
      "type": "object",
      "properties": {
        "handleKind": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "ownerIssue": { "$ref": "#/$defs/issue" },
        "reason": { "const": "tool-reference-only" }
      },
      "required": ["handleKind", "ownerIssue", "reason"],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^hive\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$" },
        "server": { "enum": ["broker", "provider-ingress", "edge-control"] },
        "direction": {
          "enum": [
            "edge-to-broker",
            "operator-to-broker",
            "supervisor-to-broker",
            "reconciler-to-broker",
            "mixed-to-broker",
            "edge-to-provider",
            "provider-to-edge",
            "edge-to-edge",
            "operator-to-edge"
          ]
        },
        "mcpMethod": { "const": "tools/call" },
        "resultClass": {
          "enum": [
            "immediate-read",
            "immediate-durable",
            "task-create",
            "immediate-local-acceptance",
            "immediate-bounded-probe"
          ]
        },
        "ownerIssue": { "$ref": "#/$defs/issue" },
        "semanticOwnerIssue": { "$ref": "#/$defs/issue" },
        "callerRule": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "discoveryAnyScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scope" }
        }
      },
      "required": ["name", "server", "direction", "mcpMethod", "resultClass", "ownerIssue", "callerRule"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "listCache": { "$ref": "#/$defs/cache" },
    "staticDescriptorCache": { "$ref": "#/$defs/cache" },
    "resources": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resource" }
    },
    "referenceOnlyHandles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/referenceOnlyHandle" }
    },
    "tools": {
      "type": "array",
      "minItems": 37,
      "maxItems": 37,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "required": ["schemaVersion", "listCache", "staticDescriptorCache", "resources", "referenceOnlyHandles", "tools"],
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "listCache": { "cacheScope": "private", "ttlMs": 5000 },
      "staticDescriptorCache": { "cacheScope": "public", "ttlMs": 300000 },
      "resources": [
        { "handleKind": "event", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "event-read-visible", "discoveryAnyScopes": ["event:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "deliveries", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "delivery-read-page-visible", "discoveryAnyScopes": ["delivery:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "delivery", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "owning-edge-or-delivery-read-visible", "discoveryAnyScopes": ["delivery:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "deliveryTransitions", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "owning-edge-or-delivery-read-visible", "discoveryAnyScopes": ["delivery:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "deliveryReplay", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "owning-edge-replay-or-slack-replay-visible", "discoveryAnyScopes": ["replay:read", "slack-replay:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "deliveryEvidence", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "owning-edge-or-evidence-read-visible", "discoveryAnyScopes": ["evidence:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "deliveryEvidenceItem", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "owning-edge-or-evidence-read-visible", "discoveryAnyScopes": ["evidence:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "dispatch", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "owning-edge-or-delivery-read-visible", "discoveryAnyScopes": ["delivery:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "dispatchEvidence", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "owning-edge-or-evidence-read-attempt-visible", "discoveryAnyScopes": ["evidence:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "reconciliationPending", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-911", "callerRule": "reconciliation-read-page-visible", "discoveryAnyScopes": ["reconciliation:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "reconciliationObligation", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-911", "callerRule": "reconciliation-read-visible", "discoveryAnyScopes": ["reconciliation:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "integrityAlerts", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-911", "callerRule": "integrity-read-page-visible", "discoveryAnyScopes": ["integrity:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "integrityAlert", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-911", "callerRule": "integrity-read-visible", "discoveryAnyScopes": ["integrity:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "outbox", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-911", "callerRule": "outbox-read-page-visible", "discoveryAnyScopes": ["outbox:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "outboxItem", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-911", "callerRule": "outbox-read-visible", "discoveryAnyScopes": ["outbox:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "subscriptions", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "subscription-read-page-visible", "discoveryAnyScopes": ["subscription:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "subscription", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "subscription-read-visible-or-leasing-edge", "discoveryAnyScopes": ["subscription:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "edges", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "edge-read-page-visible", "discoveryAnyScopes": ["edge:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "edge", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "self-or-edge-read-or-credential-read-target", "discoveryAnyScopes": ["edge:read", "edge-credential:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "edgePending", "server": "broker", "methods": ["resources/read", "subscriptions/listen"], "ownerIssue": "KRA-903", "callerRule": "self-edge-only", "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "provider", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "self-or-provider-read-visible", "discoveryAnyScopes": ["provider:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "workspace", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "mapped-edge-or-workspace-read-visible", "discoveryAnyScopes": ["workspace:read"], "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "reasonCodes", "server": "broker", "methods": ["resources/read"], "ownerIssue": "KRA-903", "callerRule": "authenticated-client", "cache": { "cacheScope": "public", "ttlMs": 3600000 } },
        { "handleKind": "localBinding", "server": "edge-control", "methods": ["resources/read"], "ownerIssue": "KRA-908", "callerRule": "edge-executor-or-matching-binding", "cache": { "cacheScope": "private", "ttlMs": 0 } },
        { "handleKind": "localProvider", "server": "provider-ingress", "methods": ["resources/read"], "ownerIssue": "KRA-908", "callerRule": "edge-with-matching-binding", "cache": { "cacheScope": "private", "ttlMs": 0 } }
      ],
      "referenceOnlyHandles": [
        { "handleKind": "credentialLineage", "ownerIssue": "KRA-900", "reason": "tool-reference-only" },
        { "handleKind": "credentialKey", "ownerIssue": "KRA-900", "reason": "tool-reference-only" }
      ],
      "tools": [
        { "name": "hive.delivery.claim", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "callerRule": "edge" },
        { "name": "hive.delivery.accept", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "callerRule": "owning-edge" },
        { "name": "hive.delivery.renew_lease", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "semanticOwnerIssue": "KRA-909", "callerRule": "owning-edge" },
        { "name": "hive.delivery.begin_dispatch", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "task-create", "ownerIssue": "KRA-904", "callerRule": "owning-edge" },
        { "name": "hive.delivery.authorize_live_injection", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "callerRule": "owning-edge" },
        { "name": "hive.delivery.record_phase", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "semanticOwnerIssue": "KRA-909", "callerRule": "owning-edge" },
        { "name": "hive.delivery.mark_dispatched", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "semanticOwnerIssue": "KRA-909", "callerRule": "owning-edge" },
        { "name": "hive.delivery.reserve_spawn", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "semanticOwnerIssue": "KRA-909", "callerRule": "owning-edge" },
        { "name": "hive.delivery.finish", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "callerRule": "owning-edge" },
        { "name": "hive.delivery.cancel", "server": "broker", "direction": "mixed-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "callerRule": "owning-edge-or-visible-operator", "discoveryAnyScopes": ["delivery:cancel"] },
        { "name": "hive.delivery.append_evidence", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "semanticOwnerIssue": "KRA-905", "callerRule": "owning-edge-or-original-lineage" },
        { "name": "hive.reply.enqueue", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-904", "semanticOwnerIssue": "KRA-905", "callerRule": "owning-edge" },
        { "name": "hive.supervisor.authorize_headless_phase", "server": "broker", "direction": "supervisor-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-900", "semanticOwnerIssue": "KRA-909", "callerRule": "enrolled-current-or-held-supervisor" },
        { "name": "hive.edge.report", "server": "broker", "direction": "mixed-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-900", "callerRule": "edge-or-enrolled-supervisor" },
        { "name": "hive.edge.confirm_binding", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-900", "callerRule": "current-machine-lineage" },
        { "name": "hive.edge_credential.mint", "server": "broker", "direction": "operator-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-900", "callerRule": "credential-mint-operator", "discoveryAnyScopes": ["edge-credential:mint"] },
        { "name": "hive.edge_credential.rotate", "server": "broker", "direction": "operator-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-900", "callerRule": "credential-rotate-operator", "discoveryAnyScopes": ["edge-credential:rotate"] },
        { "name": "hive.edge_credential.confirm", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-900", "callerRule": "pending-next-confirm-authority" },
        { "name": "hive.edge_credential.revoke", "server": "broker", "direction": "operator-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-900", "callerRule": "credential-revoke-operator", "discoveryAnyScopes": ["edge-credential:revoke"] },
        { "name": "hive.delivery.seal_evidence", "server": "broker", "direction": "edge-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-905", "callerRule": "original-lineage-evidence-authority" },
        { "name": "hive.subscription.upsert", "server": "broker", "direction": "operator-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-907", "callerRule": "subscription-admin" },
        { "name": "hive.subscription.validate", "server": "broker", "direction": "operator-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-read", "ownerIssue": "KRA-907", "callerRule": "subscription-admin" },
        { "name": "hive.dispatch.plan", "server": "broker", "direction": "operator-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-read", "ownerIssue": "KRA-907", "callerRule": "dispatch-plan-visible-operator", "discoveryAnyScopes": ["dispatch:plan"] },
        { "name": "hive.delivery.reconcile", "server": "broker", "direction": "reconciler-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-911", "callerRule": "delivery-reconciler", "discoveryAnyScopes": ["reconciliation:write"] },
        { "name": "hive.outbox.reconcile", "server": "broker", "direction": "reconciler-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-911", "callerRule": "outbox-reconciler", "discoveryAnyScopes": ["outbox:reconcile"] },
        { "name": "hive.integrity.acknowledge", "server": "broker", "direction": "reconciler-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-911", "callerRule": "integrity-acknowledger", "discoveryAnyScopes": ["integrity:acknowledge"] },
        { "name": "hive.integrity.resolve", "server": "broker", "direction": "reconciler-to-broker", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-911", "callerRule": "integrity-resolver", "discoveryAnyScopes": ["integrity:resolve"] },
        { "name": "hive.live.describe", "server": "provider-ingress", "direction": "edge-to-provider", "mcpMethod": "tools/call", "resultClass": "immediate-read", "ownerIssue": "KRA-908", "callerRule": "edge-executor" },
        { "name": "hive.live.deliver", "server": "provider-ingress", "direction": "edge-to-provider", "mcpMethod": "tools/call", "resultClass": "immediate-local-acceptance", "ownerIssue": "KRA-908", "callerRule": "edge-executor" },
        { "name": "hive.live.attest_nonacceptance", "server": "provider-ingress", "direction": "edge-to-provider", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-908", "callerRule": "current-or-held-launch-binding" },
        { "name": "hive.live.cancel", "server": "provider-ingress", "direction": "edge-to-provider", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-908", "callerRule": "current-binding-or-cancel-hold" },
        { "name": "hive.binding.register", "server": "edge-control", "direction": "provider-to-edge", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-908", "callerRule": "provider-bridge-bootstrap" },
        { "name": "hive.binding.renew", "server": "edge-control", "direction": "provider-to-edge", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-908", "callerRule": "matching-provider-bridge" },
        { "name": "hive.binding.confirm", "server": "edge-control", "direction": "provider-to-edge", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-908", "callerRule": "matching-pending-binding" },
        { "name": "hive.binding.prepare_ack", "server": "edge-control", "direction": "edge-to-edge", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-908", "callerRule": "edge-executor-current-delivery" },
        { "name": "hive.binding.ack", "server": "edge-control", "direction": "provider-to-edge", "mcpMethod": "tools/call", "resultClass": "immediate-durable", "ownerIssue": "KRA-908", "callerRule": "matching-provider-bridge" },
        { "name": "hive.provider.probe", "server": "edge-control", "direction": "operator-to-edge", "mcpMethod": "tools/call", "resultClass": "immediate-bounded-probe", "ownerIssue": "KRA-910", "callerRule": "local-provider-probe-operator", "discoveryAnyScopes": ["provider:probe"] }
      ]
    }
  ]
}
