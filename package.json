{
  "name": "@skrates/hive",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven cross-workstation wake router for frontier-model teammates",
  "type": "module",
  "bin": {
    "hive": "./dist/cli.js",
    "hive-claude-hook": "./dist/channel/claude-hook.js",
    "hive-codex-live": "./dist/codex/live.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "bun run check:mcp-imports && bun run check:contracts && bun run build && bun run test",
    "check:mcp-imports": "node scripts/check-mcp-import-boundary.mjs",
    "check:contracts": "node scripts/gen-contract-types.mjs && git diff --exit-code -- src/review/contract.generated.ts",
    "dev": "node --enable-source-maps dist/cli.js",
    "test": "node --test 'dist/**/*.test.js'"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@slack/socket-mode": "^2.0.5",
    "@slack/web-api": "^7.13.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "undici": "^8.10.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.9",
    "@types/ws": "^8.18.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3"
  }
}
