<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>is.sokrates.hive-broker</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>__HOME__/.local/lib/hive/deploy/launchd/run-broker.zsh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/Hive/broker.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/Hive/broker.err.log</string>
</dict>
</plist>
