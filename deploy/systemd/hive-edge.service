[Unit]
Description=Hive provider edge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd does NOT inherit the login shell's PATH: a service gets a fixed minimal
# PATH, so a node installed outside it (nvm, a versioned prefix) is invisible and
# `/usr/bin/env node` would exit 127 in a Restart loop. This default finds a
# distro node (/usr/bin/node). A machine whose node lives elsewhere sets PATH in
# edge.env with its node's bin dir prepended — that later EnvironmentFile
# assignment overrides this line. (The executable itself must stay a literal
# path, so it cannot be a variable; /usr/bin/env resolves node from PATH.)
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# libuv's default threadpool is 4, which is exactly MAX_CONCURRENT_DISPATCHES.
# The claim-time attestation read runs on that pool and can park indefinitely on
# a stalled network mount (home-as-profile is a supported profile shape), and a
# timeout cannot reclaim a blocked thread. At the default, four such reads
# consume the whole pool and every other fs/dns/crypto job on the edge queues
# behind them. Sized above the dispatch cap with margin so a stalled mount costs
# threads it can afford to lose.
Environment=UV_THREADPOOL_SIZE=16
EnvironmentFile=%h/.config/hive/edge.env
ExecStart=/usr/bin/env node %h/.local/lib/hive/dist/cli.js edge
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
