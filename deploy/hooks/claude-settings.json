{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hive-claude-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hive-claude-hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(hive:*)"
    ]
  }
}