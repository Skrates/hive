# Hive broker — dev box (192.168.1.238), /etc/hive/broker.env (mode 0600, owner hive)
HIVE_BROKER_DB=/var/lib/hive/hive-broker.sqlite
# Bind the tailnet address so cx43 + runpod edges can reach it; never 0.0.0.0.
HIVE_BROKER_HOST=100.x.y.z
HIVE_BROKER_PORT=8790
HIVE_ADMIN_TOKEN=<32+ char random>
HIVE_SLACK_APP_TOKEN=xapp-...
HIVE_SLACK_BOT_TOKEN=xoxb-...
HIVE_SLACK_WORKSPACE_ID=T...
# ADR-0003 R-1 closed trust set: BOTH operator seats + the Hive app id.
HIVE_ADMISSION_POLICY={"workspaceIds":["T..."],"channelIds":["C0BGBEQQQHH"],"userIds":["U0AQM4YL9HS","U0AND2JSHV1"],"appIds":["A..."]}
# Optional. Channel the deafness watchdog posts its link canaries to (each is
# hive_*-stamped, so admission drops it, and each is deleted once observed).
# Defaults to the first admitted channel — the commons. Point it at a dedicated
# channel the broker is a member of to keep the canaries out of #hive.
# HIVE_WATCHDOG_PROBE_CHANNEL=C...
