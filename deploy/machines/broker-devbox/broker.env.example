# Hive broker — dev box (192.168.1.238), /etc/hive/broker.env (mode 0600, owner hive)
HIVE_BROKER_DB=/var/lib/hive/hive-broker.sqlite
# Bind the tailnet address so cx43 + runpod edges can reach it; never 0.0.0.0.
HIVE_BROKER_HOST=100.x.y.z
HIVE_BROKER_PORT=8790
HIVE_ADMIN_TOKEN=<32+ char random>
HIVE_SLACK_APP_TOKEN=xapp-...
HIVE_SLACK_BOT_TOKEN=xoxb-...
HIVE_SLACK_WORKSPACE_ID=T...
# ADR-0003 R-1 closed trust set: BOTH operator seats + the Hive app id.
HIVE_ADMISSION_POLICY={"workspaceIds":["T..."],"channelIds":["C0BGBEQQQHH"],"userIds":["U0AQM4YL9HS","U0AND2JSHV1"],"appIds":["A..."]}
# Optional. Channel the deafness watchdog posts its link canaries to (each is
# hive_*-stamped, so admission drops it, and each is deleted once observed).
# Defaults to the first admitted channel — the commons. A dedicated channel keeps
# the canaries out of #hive, but the app must RECEIVE its messages, not just post
# them: a private channel needs groups:history + message.groups, a public one
# channels:history + message.channels. Without the matching pair every canary
# posts and never returns, and the watchdog reads that as deafness.
# HIVE_WATCHDOG_PROBE_CHANNEL=C...

# Review state machine — GitHub App (design §7). Secrets are owner-only (0600) files, never
# bare values. Set all three or none: with none set the broker boots with the adapter disabled
# (webhook 404, no reconcile, Slack board line only). A partial set, a named file that does not
# exist, or a file readable beyond its owner is a boot failure — never a silently deaf broker.
# HIVE_GITHUB_WEBHOOK_SECRET_FILE=/etc/hive/github-webhook.secret
# HIVE_GITHUB_APP_ID=<app id>
# HIVE_GITHUB_APP_KEY_FILE=/etc/hive/github-app.pem
