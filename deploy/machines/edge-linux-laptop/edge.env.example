# Hive edge — linux laptop, ~/.config/hive/edge.env (mode 0600)
# Seat: fable (Claude Max, rationallyprime@gmail.com)
# NOTE: EnvironmentFile values are literal — absolute paths only, no %h/~ expansion.
#
# PATH: this machine's node is nvm-managed, so prepend its bin dir to the service
# PATH (the unit's default only finds a distro /usr/bin/node). This assignment
# overrides the unit's Environment=PATH default. Keep the standard dirs after it.
# Omit this line entirely on a machine whose node is already at /usr/bin/node.
PATH=/home/rationallyprime/.nvm/versions/node/v22.11.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HIVE_BROKER_URL=http://100.x.y.z:8790
HIVE_EDGE_ID=laptop
HIVE_EDGE_TOKEN=<from: hive create-edge laptop>
HIVE_EDGE_DB=/home/rationallyprime/.hive/hive-edge.sqlite
HIVE_EDGE_SOCKET=/home/rationallyprime/.hive/edge.sock
HIVE_INGRESS_DIR=/home/rationallyprime/.hive/ingress
