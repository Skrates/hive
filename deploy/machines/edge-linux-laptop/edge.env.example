# Hive edge — linux laptop, ~/.config/hive/edge.env (mode 0600)
# Seat: fable (Claude Max, rationallyprime@gmail.com)
# NOTE: EnvironmentFile values are literal — absolute paths only, no %h/~ expansion.
HIVE_BROKER_URL=http://100.x.y.z:8790
HIVE_EDGE_ID=laptop
HIVE_EDGE_TOKEN=<from: hive create-edge laptop>
HIVE_EDGE_DB=/home/rationallyprime/.hive/hive-edge.sqlite
HIVE_EDGE_SOCKET=/home/rationallyprime/.hive/edge.sock
HIVE_INGRESS_DIR=/home/rationallyprime/.hive/ingress
