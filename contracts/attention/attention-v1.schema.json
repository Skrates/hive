{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive.skrates.dev/contracts/attention/attention-v1.schema.json",
  "title": "AttentionContract",
  "description": "Hive Attention v1: the durable human-intervention queue. Hive owns this schema (ADR-0004); it is not vendored. Every shape the broker admits or emits for attention is a $defs entry here.",
  "$defs": {
    "SchemaVersion": { "title": "SchemaVersion", "type": "integer", "const": 1 },
    "HumanId": {
      "title": "HumanId",
      "description": "A configured queue identity (`hakon` first). Not a provider actor and never enrolled as one.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "ActorId": { "title": "ActorId", "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "EdgeId": { "title": "EdgeId", "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "Provider": { "title": "Provider", "type": "string", "enum": ["codex", "claude", "grok"] },
    "ProjectId": { "title": "ProjectId", "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "WorkId": { "title": "WorkId", "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "InterventionKey": { "title": "InterventionKey", "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "CommandId": {
      "title": "CommandId",
      "description": "A client-minted UUID naming one mutation. The same id with the same content replays the committed receipt.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ItemId": { "title": "ItemId", "type": "integer", "minimum": 1 },
    "Revision": { "title": "Revision", "type": "integer", "minimum": 1 },
    "ReturnGeneration": { "title": "ReturnGeneration", "type": "integer", "minimum": 1 },
    "SourceId": { "title": "SourceId", "type": "string", "pattern": "^src_[0-9a-f]{32}$" },
    "Timestamp": {
      "title": "Timestamp",
      "description": "RFC 3339 with an explicit offset. The broker canonicalizes to UTC milliseconds before persistence and compares instants, never strings.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "Reason": { "title": "Reason", "type": "string", "minLength": 1, "maxLength": 800, "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]+$" },
    "InterventionKind": {
      "title": "InterventionKind",
      "type": "string",
      "enum": ["review", "decision", "selection", "unblock", "human_work"]
    },
    "ResolutionOutcome": {
      "title": "ResolutionOutcome",
      "description": "Workflow labels, not permissions or executable actions.",
      "type": "string",
      "enum": ["approved", "changes_requested", "answered", "selected", "delegated", "completed"]
    },
    "ItemState": { "title": "ItemState", "type": "string", "enum": ["queued", "active", "deferred", "resolved", "cancelled"] },
    "ReturnMode": { "title": "ReturnMode", "type": "string", "enum": ["pinned_session", "actor_context", "none"] },
    "ReturnPhase": {
      "title": "ReturnPhase",
      "type": "string",
      "enum": ["pending", "blocked", "minted", "processed", "failed", "superseded"]
    },
    "SourceProvenance": { "title": "SourceProvenance", "type": "string", "enum": ["dispatch", "live_registration", "operator_binding"] },
    "Artifact": {
      "title": "Artifact",
      "description": "A reference, never fetched or interpreted by the broker. `https://…`, a Hive handle (`hive:…`), or an absolute file path — which must name its owning `edge_id`, so a path on a remote seat is never presented as a local file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "uri"],
      "if": { "type": "object", "required": ["uri"], "properties": { "uri": { "type": "string", "pattern": "^/" } } },
      "then": { "type": "object", "required": ["edge_id"] },
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "uri": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(https://[^\\s]+|hive:[^\\s]+|/[^\\u0000-\\u001f\\u007f]*)$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "edge_id": { "$ref": "#/$defs/EdgeId" }
      }
    },
    "InterventionPacket": {
      "title": "InterventionPacket",
      "description": "What a producer authors. Source identity, state, revision, ready sequence, claimed human and return route are never packet fields.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_id", "project_id", "work_id", "intervention_key", "kind", "title", "requested_action",
        "context", "unblocks", "artifacts", "estimate_minutes", "deadline_at", "predecessor_item_id"
      ],
      "properties": {
        "human_id": { "$ref": "#/$defs/HumanId" },
        "project_id": { "$ref": "#/$defs/ProjectId" },
        "work_id": { "$ref": "#/$defs/WorkId" },
        "intervention_key": { "$ref": "#/$defs/InterventionKey" },
        "kind": { "$ref": "#/$defs/InterventionKind" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "requested_action": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "context": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "unblocks": { "type": "string", "minLength": 1, "maxLength": 800 },
        "artifacts": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/Artifact" } },
        "estimate_minutes": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 240 }, { "type": "null" }] },
        "deadline_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "predecessor_item_id": { "anyOf": [{ "$ref": "#/$defs/ItemId" }, { "type": "null" }] }
      }
    },
    "PacketAmendment": {
      "title": "PacketAmendment",
      "description": "Replacement values for the producer-mutable packet fields. Identity, owner, state, source, predecessor and route are not amendable.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "requested_action": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "context": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "unblocks": { "type": "string", "minLength": 1, "maxLength": 800 },
        "artifacts": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/Artifact" } },
        "estimate_minutes": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 240 }, { "type": "null" }] },
        "deadline_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "SummonCommand": {
      "title": "SummonCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "summon" },
        "payload": { "$ref": "#/$defs/InterventionPacket" }
      }
    },
    "AmendPayload": {
      "title": "AmendPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "expected_revision", "fields"],
      "properties": {
        "item_id": { "$ref": "#/$defs/ItemId" },
        "expected_revision": { "$ref": "#/$defs/Revision" },
        "fields": { "$ref": "#/$defs/PacketAmendment" }
      }
    },
    "AmendCommand": {
      "title": "AmendCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "amend" },
        "payload": { "$ref": "#/$defs/AmendPayload" }
      }
    },
    "ItemReasonPayload": {
      "title": "ItemReasonPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "expected_revision", "reason"],
      "properties": {
        "item_id": { "$ref": "#/$defs/ItemId" },
        "expected_revision": { "$ref": "#/$defs/Revision" },
        "reason": { "$ref": "#/$defs/Reason" }
      }
    },
    "WithdrawCommand": {
      "title": "WithdrawCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "withdraw" },
        "payload": { "$ref": "#/$defs/ItemReasonPayload" }
      }
    },
    "HumanPacketPayload": {
      "title": "HumanPacketPayload",
      "description": "Human-first work. `return_source_id` optionally binds an already-enrolled source so a resolution returns to it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["packet", "return_source_id"],
      "properties": {
        "packet": { "$ref": "#/$defs/InterventionPacket" },
        "return_source_id": { "anyOf": [{ "$ref": "#/$defs/SourceId" }, { "type": "null" }] }
      }
    },
    "AddCommand": {
      "title": "AddCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "add" },
        "payload": { "$ref": "#/$defs/HumanPacketPayload" }
      }
    },
    "StartCommand": {
      "title": "StartCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "start" },
        "payload": { "$ref": "#/$defs/HumanPacketPayload" }
      }
    },
    "NextPayload": {
      "title": "NextPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["human_id", "item_id"],
      "properties": {
        "human_id": { "$ref": "#/$defs/HumanId" },
        "item_id": { "anyOf": [{ "$ref": "#/$defs/ItemId" }, { "type": "null" }] }
      }
    },
    "NextCommand": {
      "title": "NextCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "next" },
        "payload": { "$ref": "#/$defs/NextPayload" }
      }
    },
    "ResolvePayload": {
      "title": "ResolvePayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "expected_revision", "outcome", "response", "select_next"],
      "properties": {
        "item_id": { "$ref": "#/$defs/ItemId" },
        "expected_revision": { "$ref": "#/$defs/Revision" },
        "outcome": { "$ref": "#/$defs/ResolutionOutcome" },
        "response": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "select_next": { "type": "boolean" }
      }
    },
    "ResolveCommand": {
      "title": "ResolveCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "resolve" },
        "payload": { "$ref": "#/$defs/ResolvePayload" }
      }
    },
    "DeferPayload": {
      "title": "DeferPayload",
      "description": "`until` null is an explicit indefinite hold; it never promotes on its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "expected_revision", "reason", "until", "select_next"],
      "properties": {
        "item_id": { "$ref": "#/$defs/ItemId" },
        "expected_revision": { "$ref": "#/$defs/Revision" },
        "reason": { "$ref": "#/$defs/Reason" },
        "until": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "select_next": { "type": "boolean" }
      }
    },
    "DeferCommand": {
      "title": "DeferCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "defer" },
        "payload": { "$ref": "#/$defs/DeferPayload" }
      }
    },
    "RequeueCommand": {
      "title": "RequeueCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "requeue" },
        "payload": { "$ref": "#/$defs/ItemReasonPayload" }
      }
    },
    "CancelPayload": {
      "title": "CancelPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "expected_revision", "reason", "select_next"],
      "properties": {
        "item_id": { "$ref": "#/$defs/ItemId" },
        "expected_revision": { "$ref": "#/$defs/Revision" },
        "reason": { "$ref": "#/$defs/Reason" },
        "select_next": { "type": "boolean" }
      }
    },
    "CancelCommand": {
      "title": "CancelCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "cancel" },
        "payload": { "$ref": "#/$defs/CancelPayload" }
      }
    },
    "RetryReturnPayload": {
      "title": "RetryReturnPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "expected_revision", "return_generation"],
      "properties": {
        "item_id": { "$ref": "#/$defs/ItemId" },
        "expected_revision": { "$ref": "#/$defs/Revision" },
        "return_generation": { "$ref": "#/$defs/ReturnGeneration" }
      }
    },
    "RetryReturnCommand": {
      "title": "RetryReturnCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "retry_return" },
        "payload": { "$ref": "#/$defs/RetryReturnPayload" }
      }
    },
    "RerouteReturnPayload": {
      "title": "RerouteReturnPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "expected_revision", "return_generation", "source_id", "reason"],
      "properties": {
        "item_id": { "$ref": "#/$defs/ItemId" },
        "expected_revision": { "$ref": "#/$defs/Revision" },
        "return_generation": { "$ref": "#/$defs/ReturnGeneration" },
        "source_id": { "$ref": "#/$defs/SourceId" },
        "reason": { "$ref": "#/$defs/Reason" }
      }
    },
    "RerouteReturnCommand": {
      "title": "RerouteReturnCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "reroute_return" },
        "payload": { "$ref": "#/$defs/RerouteReturnPayload" }
      }
    },
    "SourceRevokePayload": {
      "title": "SourceRevokePayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "reason"],
      "properties": {
        "source_id": { "$ref": "#/$defs/SourceId" },
        "reason": { "$ref": "#/$defs/Reason" }
      }
    },
    "SourceRevokeCommand": {
      "title": "SourceRevokeCommand",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "source_revoke" },
        "payload": { "$ref": "#/$defs/SourceRevokePayload" }
      }
    },
    "AttentionCommand": {
      "title": "AttentionCommand",
      "description": "The strict mutation envelope at `POST /v1/attention/commands`. The authenticated principal, never the body, decides which actions are allowed.",
      "type": "object",
      "discriminator": { "propertyName": "action" },
      "required": ["action"],
      "oneOf": [
        { "$ref": "#/$defs/SummonCommand" },
        { "$ref": "#/$defs/AmendCommand" },
        { "$ref": "#/$defs/WithdrawCommand" },
        { "$ref": "#/$defs/AddCommand" },
        { "$ref": "#/$defs/StartCommand" },
        { "$ref": "#/$defs/NextCommand" },
        { "$ref": "#/$defs/ResolveCommand" },
        { "$ref": "#/$defs/DeferCommand" },
        { "$ref": "#/$defs/RequeueCommand" },
        { "$ref": "#/$defs/CancelCommand" },
        { "$ref": "#/$defs/RetryReturnCommand" },
        { "$ref": "#/$defs/RerouteReturnCommand" },
        { "$ref": "#/$defs/SourceRevokeCommand" }
      ]
    },
    "SlackThread": {
      "title": "SlackThread",
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "thread_ts"],
      "properties": {
        "channel_id": { "type": "string", "pattern": "^[CDG][A-Z0-9]{2,30}$" },
        "thread_ts": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "DispatchEvidence": {
      "title": "DispatchEvidence",
      "description": "Edge-resolved from a running dispatch token. The broker fences it with assertLease and derives the actor from the delivery.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_delivery_id", "generation", "route", "session_id", "cwd"],
      "properties": {
        "kind": { "type": "string", "const": "dispatch" },
        "source_delivery_id": { "type": "integer", "minimum": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "route": { "type": "string", "enum": ["live", "resume", "spawn", "pinned_resume"] },
        "session_id": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 200 }, { "type": "null" }] },
        "cwd": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }] }
      }
    },
    "LiveEvidence": {
      "title": "LiveEvidence",
      "description": "Edge-verified against an unexpired live registration matching actor, provider and session exactly.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "provider", "session_id", "cwd", "surface_version"],
      "properties": {
        "kind": { "type": "string", "const": "live_registration" },
        "actor": { "$ref": "#/$defs/ActorId" },
        "provider": { "$ref": "#/$defs/Provider" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "cwd": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }] },
        "surface_version": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "OperatorEvidence": {
      "title": "OperatorEvidence",
      "description": "An explicit operator enrollment on the source edge. A session counts as verified only when this edge's live registry holds it exactly; provider names the registry that verified it, and is null otherwise.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "session_id", "session_verified", "provider", "cwd"],
      "if": { "type": "object", "required": ["session_verified"], "properties": { "session_verified": { "const": "live_registry" } } },
      "then": { "type": "object", "properties": { "provider": { "$ref": "#/$defs/Provider" } } },
      "else": { "type": "object", "properties": { "provider": { "type": "null" } } },
      "properties": {
        "kind": { "type": "string", "const": "operator_binding" },
        "actor": { "$ref": "#/$defs/ActorId" },
        "session_id": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 200 }, { "type": "null" }] },
        "session_verified": { "type": "string", "enum": ["live_registry", "none"] },
        "provider": { "anyOf": [{ "$ref": "#/$defs/Provider" }, { "type": "null" }] },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "SourceEvidence": {
      "title": "SourceEvidence",
      "type": "object",
      "discriminator": { "propertyName": "kind" },
      "required": ["kind"],
      "oneOf": [
        { "$ref": "#/$defs/DispatchEvidence" },
        { "$ref": "#/$defs/LiveEvidence" },
        { "$ref": "#/$defs/OperatorEvidence" }
      ]
    },
    "SourceBindPayload": {
      "title": "SourceBindPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "work_id", "return_mode", "thread", "evidence"],
      "properties": {
        "project_id": { "$ref": "#/$defs/ProjectId" },
        "work_id": { "$ref": "#/$defs/WorkId" },
        "return_mode": { "$ref": "#/$defs/ReturnMode" },
        "thread": { "anyOf": [{ "$ref": "#/$defs/SlackThread" }, { "type": "null" }] },
        "evidence": { "$ref": "#/$defs/SourceEvidence" }
      }
    },
    "SourceBindCommand": {
      "title": "SourceBindCommand",
      "description": "Edge → broker at `POST /v1/attention/sources`. The edge builds the evidence; a caller never names an actor as proof.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "action", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": { "type": "string", "const": "source_bind" },
        "payload": { "$ref": "#/$defs/SourceBindPayload" }
      }
    },
    "PinnedRoute": {
      "title": "PinnedRoute",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "home_edge", "account_profile_fingerprint", "session_id", "cwd"],
      "properties": {
        "provider": { "$ref": "#/$defs/Provider" },
        "home_edge": { "$ref": "#/$defs/EdgeId" },
        "account_profile_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "PinnedContinuationTarget": {
      "title": "PinnedContinuationTarget",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol", "source_id", "resolution_command_id", "generation", "actor", "mode", "pinned"],
      "properties": {
        "kind": { "type": "string", "const": "attention_return" },
        "protocol": { "type": "integer", "const": 1 },
        "source_id": { "$ref": "#/$defs/SourceId" },
        "resolution_command_id": { "$ref": "#/$defs/CommandId" },
        "generation": { "$ref": "#/$defs/ReturnGeneration" },
        "actor": { "$ref": "#/$defs/ActorId" },
        "mode": { "type": "string", "const": "pinned_session" },
        "pinned": { "$ref": "#/$defs/PinnedRoute" }
      }
    },
    "ContextContinuationTarget": {
      "title": "ContextContinuationTarget",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol", "source_id", "resolution_command_id", "generation", "actor", "mode", "pinned"],
      "properties": {
        "kind": { "type": "string", "const": "attention_return" },
        "protocol": { "type": "integer", "const": 1 },
        "source_id": { "$ref": "#/$defs/SourceId" },
        "resolution_command_id": { "$ref": "#/$defs/CommandId" },
        "generation": { "$ref": "#/$defs/ReturnGeneration" },
        "actor": { "$ref": "#/$defs/ActorId" },
        "mode": { "type": "string", "const": "actor_context" },
        "pinned": { "type": "null" }
      }
    },
    "AttentionContinuationTarget": {
      "title": "AttentionContinuationTarget",
      "description": "Broker-derived routing metadata written on the core delivery in the mint transaction. `pinned` is non-null exactly for `pinned_session`.",
      "type": "object",
      "discriminator": { "propertyName": "mode" },
      "required": ["mode"],
      "oneOf": [
        { "$ref": "#/$defs/PinnedContinuationTarget" },
        { "$ref": "#/$defs/ContextContinuationTarget" }
      ]
    },
    "SourceView": {
      "title": "SourceView",
      "description": "Public source metadata. The local source handle never appears here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "provenance", "edge_id", "issuer_principal", "owner_principal", "actor", "provider", "project_id", "work_id",
        "return_mode", "session_id", "session_absence", "cwd", "account_profile_fingerprint", "source_delivery_id",
        "thread", "created_at", "revoked_at", "revoked_reason"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/SourceId" },
        "provenance": { "$ref": "#/$defs/SourceProvenance" },
        "edge_id": { "$ref": "#/$defs/EdgeId" },
        "issuer_principal": { "type": "string", "minLength": 1 },
        "owner_principal": { "type": "string", "minLength": 1 },
        "actor": { "$ref": "#/$defs/ActorId" },
        "provider": { "$ref": "#/$defs/Provider" },
        "project_id": { "$ref": "#/$defs/ProjectId" },
        "work_id": { "$ref": "#/$defs/WorkId" },
        "return_mode": { "$ref": "#/$defs/ReturnMode" },
        "session_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "session_absence": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "cwd": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "account_profile_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_delivery_id": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "thread": { "anyOf": [{ "$ref": "#/$defs/SlackThread" }, { "type": "null" }] },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "revoked_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "revoked_reason": { "anyOf": [{ "$ref": "#/$defs/Reason" }, { "type": "null" }] }
      }
    },
    "TransportStatus": {
      "title": "TransportStatus",
      "description": "The core Hive delivery state behind a minted return, projected at read time or snapshotted once terminal.",
      "type": "string",
      "enum": [
        "pending", "claimed", "accepted_local", "dispatching", "dispatched", "processed", "undeliverable", "failed",
        "transport_record_missing"
      ]
    },
    "ReturnView": {
      "title": "ReturnView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "return_id", "item_id", "resolution_command_id", "generation", "source_id", "mode", "phase", "reason",
        "next_attempt_at", "delivery_id", "transport_status", "observed_at"
      ],
      "properties": {
        "return_id": { "type": "integer", "minimum": 1 },
        "item_id": { "$ref": "#/$defs/ItemId" },
        "resolution_command_id": { "$ref": "#/$defs/CommandId" },
        "generation": { "$ref": "#/$defs/ReturnGeneration" },
        "source_id": { "$ref": "#/$defs/SourceId" },
        "mode": { "type": "string", "enum": ["pinned_session", "actor_context"] },
        "phase": { "$ref": "#/$defs/ReturnPhase" },
        "reason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "next_attempt_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "delivery_id": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "transport_status": { "anyOf": [{ "$ref": "#/$defs/TransportStatus" }, { "type": "null" }] },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ItemView": {
      "title": "ItemView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "human_id", "owner_principal", "origin", "state", "revision", "ready_sequence", "deferred_until",
        "packet", "source", "return_mode", "created_at", "updated_at", "claimed_at", "resolved_at", "outcome",
        "response", "terminal_reason", "return"
      ],
      "properties": {
        "item_id": { "$ref": "#/$defs/ItemId" },
        "human_id": { "$ref": "#/$defs/HumanId" },
        "owner_principal": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "enum": ["seat", "human"] },
        "state": { "$ref": "#/$defs/ItemState" },
        "revision": { "$ref": "#/$defs/Revision" },
        "ready_sequence": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "deferred_until": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "packet": { "$ref": "#/$defs/InterventionPacket" },
        "source": { "anyOf": [{ "$ref": "#/$defs/SourceView" }, { "type": "null" }] },
        "return_mode": { "$ref": "#/$defs/ReturnMode" },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "updated_at": { "$ref": "#/$defs/Timestamp" },
        "claimed_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "resolved_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "outcome": { "anyOf": [{ "$ref": "#/$defs/ResolutionOutcome" }, { "type": "null" }] },
        "response": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "terminal_reason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "return": { "anyOf": [{ "$ref": "#/$defs/ReturnView" }, { "type": "null" }] }
      }
    },
    "ItemRef": {
      "title": "ItemRef",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "revision", "state"],
      "properties": {
        "item_id": { "$ref": "#/$defs/ItemId" },
        "revision": { "$ref": "#/$defs/Revision" },
        "state": { "$ref": "#/$defs/ItemState" }
      }
    },
    "ReturnRef": {
      "title": "ReturnRef",
      "type": "object",
      "additionalProperties": false,
      "required": ["return_id", "generation", "phase"],
      "properties": {
        "return_id": { "type": "integer", "minimum": 1 },
        "generation": { "$ref": "#/$defs/ReturnGeneration" },
        "phase": { "$ref": "#/$defs/ReturnPhase" }
      }
    },
    "SelectionReason": {
      "title": "SelectionReason",
      "type": "string",
      "enum": ["fifo", "explicit_pick", "already_active", "empty"]
    },
    "Selection": {
      "title": "Selection",
      "description": "What `next` (or a `--next` combined mutation) selected, as of the commit. The deterministic brief is part of the committed receipt.",
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_reason", "item", "brief", "eligible_count", "deferred_count", "next_deferred_at"],
      "properties": {
        "selection_reason": { "$ref": "#/$defs/SelectionReason" },
        "item": { "anyOf": [{ "$ref": "#/$defs/ItemView" }, { "type": "null" }] },
        "brief": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "eligible_count": { "type": "integer", "minimum": 0 },
        "deferred_count": { "type": "integer", "minimum": 0 },
        "next_deferred_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "ReceiptResult": {
      "title": "ReceiptResult",
      "type": "string",
      "enum": [
        "created", "existing", "amended", "withdrawn", "claimed", "already_active", "empty", "started", "resolved",
        "deferred", "requeued", "cancelled", "return_retry_scheduled", "return_in_flight", "return_retried",
        "return_rerouted", "source_bound", "source_revoked"
      ]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Returned only after the transaction holding the state, its events and this receipt commits (I03). A replay returns the stored receipt with `replayed: true`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "broker_uuid", "command_id", "action", "result", "replayed", "as_of", "item", "active_item",
        "return_effect", "selection", "source"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "broker_uuid": { "type": "string", "minLength": 36, "maxLength": 36 },
        "command_id": { "$ref": "#/$defs/CommandId" },
        "action": {
          "type": "string",
          "enum": [
            "summon", "amend", "withdraw", "add", "start", "next", "resolve", "defer", "requeue", "cancel",
            "retry_return", "reroute_return", "source_bind", "source_revoke"
          ]
        },
        "result": { "$ref": "#/$defs/ReceiptResult" },
        "replayed": { "type": "boolean" },
        "as_of": { "$ref": "#/$defs/Timestamp" },
        "item": { "anyOf": [{ "$ref": "#/$defs/ItemRef" }, { "type": "null" }] },
        "active_item": { "anyOf": [{ "$ref": "#/$defs/ItemRef" }, { "type": "null" }] },
        "return_effect": { "anyOf": [{ "$ref": "#/$defs/ReturnRef" }, { "type": "null" }] },
        "selection": { "anyOf": [{ "$ref": "#/$defs/Selection" }, { "type": "null" }] },
        "source": { "anyOf": [{ "$ref": "#/$defs/SourceView" }, { "type": "null" }] }
      }
    },
    "QueueStatus": {
      "title": "QueueStatus",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_id", "active_item", "eligible_count", "deferred_count", "oldest_eligible_at", "next_deferred_at",
        "returns_pending", "returns_minted", "returns_blocked", "returns_failed", "route_warnings", "observed_at"
      ],
      "properties": {
        "human_id": { "$ref": "#/$defs/HumanId" },
        "active_item": { "anyOf": [{ "$ref": "#/$defs/ItemRef" }, { "type": "null" }] },
        "eligible_count": { "type": "integer", "minimum": 0 },
        "deferred_count": { "type": "integer", "minimum": 0 },
        "oldest_eligible_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "next_deferred_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "returns_pending": { "type": "integer", "minimum": 0 },
        "returns_minted": { "type": "integer", "minimum": 0, "description": "Continuations whose core delivery is in flight; a rollback waits for zero." },
        "returns_blocked": { "type": "integer", "minimum": 0 },
        "returns_failed": { "type": "integer", "minimum": 0 },
        "route_warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "generation", "phase", "reason"],
            "properties": {
              "item_id": { "$ref": "#/$defs/ItemId" },
              "generation": { "$ref": "#/$defs/ReturnGeneration" },
              "phase": { "$ref": "#/$defs/ReturnPhase" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "QueuePage": {
      "title": "QueuePage",
      "description": "One keyset page. A moving queue is not a snapshot; refresh from the head for a newly ordered view.",
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "status", "items", "next_cursor"],
      "properties": {
        "as_of": { "$ref": "#/$defs/Timestamp" },
        "status": { "$ref": "#/$defs/QueueStatus" },
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/ItemView" } },
        "next_cursor": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "EventView": {
      "title": "EventView",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "item_id", "source_id", "command_id", "principal", "event_type", "revision", "created_at", "payload"],
      "properties": {
        "event_id": { "type": "integer", "minimum": 1 },
        "item_id": { "anyOf": [{ "$ref": "#/$defs/ItemId" }, { "type": "null" }] },
        "source_id": { "anyOf": [{ "$ref": "#/$defs/SourceId" }, { "type": "null" }] },
        "command_id": { "anyOf": [{ "$ref": "#/$defs/CommandId" }, { "type": "null" }] },
        "principal": { "type": "string", "minLength": 1 },
        "event_type": { "type": "string", "minLength": 1 },
        "revision": { "anyOf": [{ "$ref": "#/$defs/Revision" }, { "type": "null" }] },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "payload": { "type": "object" }
      }
    },
    "Capabilities": {
      "title": "Capabilities",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "broker_uuid", "enabled", "store_schema_version", "human_id", "actions", "return_modes", "edge_protocol", "disabled_note"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "broker_uuid": { "type": "string", "minLength": 36, "maxLength": 36 },
        "enabled": { "type": "boolean" },
        "store_schema_version": { "type": "integer", "minimum": 1 },
        "human_id": { "$ref": "#/$defs/HumanId" },
        "actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "return_modes": { "type": "array", "items": { "$ref": "#/$defs/ReturnMode" } },
        "edge_protocol": { "type": "integer", "const": 1 },
        "disabled_note": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "ReturnGuard": {
      "title": "ReturnGuard",
      "description": "Transport validation for a constrained inbox envelope immediately before emission. Session matching is the receiver's own, independent check.",
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "reason", "as_of"],
      "properties": {
        "eligible": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "as_of": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "SourceFile": {
      "title": "SourceFile",
      "description": "The owner-only (0600) file `bind --out` writes. `handle` is the local secret; it is never sent to Slack, logs or the broker.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "broker_uuid", "edge_id", "source_id", "handle", "actor", "project_id", "work_id", "return_mode", "provenance"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "broker_uuid": { "type": "string", "minLength": 36, "maxLength": 36 },
        "edge_id": { "$ref": "#/$defs/EdgeId" },
        "source_id": { "$ref": "#/$defs/SourceId" },
        "handle": { "type": "string", "pattern": "^ahs_[A-Za-z0-9_-]{43}$" },
        "actor": { "$ref": "#/$defs/ActorId" },
        "project_id": { "$ref": "#/$defs/ProjectId" },
        "work_id": { "$ref": "#/$defs/WorkId" },
        "return_mode": { "$ref": "#/$defs/ReturnMode" },
        "provenance": { "$ref": "#/$defs/SourceProvenance" }
      }
    },
    "ErrorEnvelope": {
      "title": "ErrorEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "current": { "anyOf": [{ "$ref": "#/$defs/ItemRef" }, { "type": "null" }] }
      }
    }
  }
}
